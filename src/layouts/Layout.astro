---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Dante Samacoits' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600&family=Inter:wght@400&family=Montserrat:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!--
      Scroll progress bar (07-animaciones.md): barra fina de ~2px en el borde
      superior del viewport, ancho proporcional al scroll. Encima del navbar
      (z-60 > z-50). `aria-hidden`: decorativa, el progreso no aporta a SR.
      `data-scroll-progress` es estilada/animada por scroll-progress.ts.
    -->
    <div
      data-scroll-progress
      aria-hidden="true"
      class="fixed inset-x-0 top-0 z-[60] h-[2px] origin-left bg-tertiary"
    ></div>
    <slot />
    <script>
      import '../scripts/reveal';
      import '../scripts/scroll-progress';
    </script>
  </body>
</html>