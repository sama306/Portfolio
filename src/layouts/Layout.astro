---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

/*
  Layout base con SEO (09-seo-accesibilidad-performance.md).
  Title, description, canonical, Open Graph y Twitter/X cards.
  Cada página pasa su own title/description/ogImage — no se reusa el meta
  genérico del Home en las páginas internas (proyectos/videos las generan
  desde sus propios datos).
*/

interface Props {
  title?: string;
  description?: string;
  ogImage?: string; // ruta pública, ej. "/og-image.png" o "/assets/..."
  ogType?: 'website' | 'article';
}

// Meta description por defecto (Home, según 09-seo-accesibilidad-performance.md).
const HOME_DESCRIPTION =
  'Portfolio personal de Dante Samacoits. Desarrollo de software, proyectos web, bases de datos y producción audiovisual.';

const {
  title = 'Dante Samacoits',
  description = HOME_DESCRIPTION,
  ogImage = '/og-image.png',
  ogType = 'website',
} = Astro.props;

const SITE_NAME = 'Dante Samacoits';
const siteUrl = Astro.site!;
const pageUrl = new URL(Astro.url.pathname, siteUrl);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).href;

/*
  Transición default entre páginas (Fase 5, 07-animaciones.md):
  fade-out de la página vieja + fade-in con un leve rise de la nueva,
  a tono con el lenguaje del reveal (opacity + translateY). Aplicada a
  todo el sitio vía <html transition:animate>. Los keyframes viven en
  global.css. Bajo prefers-reduced-motion ClientRouter las desactiva
  automáticamente (swap instantáneo).
*/
const pageTransition = {
  forwards: {
    old: { name: 'astro-fade-out', duration: 150, easing: 'ease-out', fillMode: 'both' },
    new: { name: 'astro-fade-in-up', duration: 350, easing: 'ease-out', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'astro-fade-out', duration: 150, easing: 'ease-in', fillMode: 'both' },
    new: { name: 'astro-fade-in-up', duration: 350, easing: 'ease-in', fillMode: 'both' },
  },
};
---

<!doctype html>
<html lang="es" transition:animate={pageTransition}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <!--
      Favicons (Fase 7, 09-seo-accesibilidad-performance.md).
      SVG como fuente principal (badge Obsidian Slate), ICO como fallback legacy,
      apple-touch-icon para iOS y manifest para install/Android.
      theme-color con la surface del sistema (#051424).
    -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#051424" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter / X cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600&family=Inter:wght@400&family=Montserrat:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!--
      Scroll progress bar (07-animaciones.md): barra fina de ~2px en el borde
      superior del viewport, ancho proporcional al scroll. Encima del navbar
      (z-60 > z-50). `aria-hidden`: decorativa, el progreso no aporta a SR.
      `data-scroll-progress` es estilada/animada por scroll-progress.ts.
    -->
    <div
      data-scroll-progress
      aria-hidden="true"
      class="fixed inset-x-0 top-0 z-[60] h-[2px] origin-left bg-tertiary"
    ></div>
    <slot />
    <script>
      import '../scripts/reveal';
      import '../scripts/scroll-progress';
      import '../scripts/view-transitions';
    </script>
  </body>
</html>