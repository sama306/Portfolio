---
import { CONTACT_EMAIL, contactFormEndpoint } from '../data/socials';
---

<!--
  Contacto — sección 6 del Home (ver 03-secciones-home.md §6).
  Formulario embebido con Formspree (AJAX, sin recarga) → llega a CONTACT_EMAIL.
  Campos: Nombre, Email, Asunto, Mensaje. Validación HTML5 + honeypot _gotcha.
  Estilo de inputs según DESIGN.md "Inputs & Forms": fondo surface inset, borde
  outline-variant, focus a tertiary con glow.
  `scroll-mt-28` para que la navbar fija no tape el título al scrollear.
  Entrada por scroll con data-reveal (Fase 5).
-->

<section
  id="contacto"
  class="mx-auto w-full max-w-[1200px] scroll-mt-28 border-t border-outline-variant px-gutter py-section-gap"
>
  <div class="mx-auto mb-12 max-w-2xl text-center" data-reveal>
    <h2 class="font-headline-md text-headline-md text-on-surface">
      ¿Tenés un proyecto en mente? Hablemos.
    </h2>
    <p class="mt-4 font-body-md text-body-md text-on-surface-variant">
      Estoy abierto a nuevas oportunidades, proyectos y colaboraciones. Si querés trabajar conmigo,
      no dudes en contactarme.
    </p>
  </div>

  <div class="mx-auto w-full max-w-xl" data-reveal data-reveal-delay="0.1">
    <!-- Formulario -->
    <form
        data-contact-form
        data-contact-email={CONTACT_EMAIL}
        action={contactFormEndpoint}
        method="POST"
        novalidate
        class="flex flex-col gap-6"
        aria-label="Formulario de contacto"
      >
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <input type="hidden" name="_subject" value="Nuevo mensaje desde tu portfolio" />

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div>
            <label for="contact-name" class="font-label-caps text-label-caps mb-2 block text-on-surface-variant">
              Nombre
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Tu nombre"
              class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-3 font-body-md text-body-md text-on-surface outline-none transition-colors duration-300 placeholder:text-on-surface-variant/50 focus:border-tertiary focus:ring-2 focus:ring-tertiary/30"
            />
          </div>
          <div>
            <label for="contact-email" class="font-label-caps text-label-caps mb-2 block text-on-surface-variant">
              Email
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="tu@email.com"
              class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-3 font-body-md text-body-md text-on-surface outline-none transition-colors duration-300 placeholder:text-on-surface-variant/50 focus:border-tertiary focus:ring-2 focus:ring-tertiary/30"
            />
          </div>
        </div>

        <div>
          <label for="contact-subject" class="font-label-caps text-label-caps mb-2 block text-on-surface-variant">
            Asunto
          </label>
          <input
            id="contact-subject"
            name="subject"
            type="text"
            required
            placeholder="Propuesta, consulta, colaboración…"
            class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-3 font-body-md text-body-md text-on-surface outline-none transition-colors duration-300 placeholder:text-on-surface-variant/50 focus:border-tertiary focus:ring-2 focus:ring-tertiary/30"
          />
        </div>

        <div>
          <label for="contact-message" class="font-label-caps text-label-caps mb-2 block text-on-surface-variant">
            Mensaje
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            placeholder="Contame sobre tu proyecto…"
            class="w-full resize-y rounded-lg border border-outline-variant bg-surface px-4 py-3 font-body-md text-body-md text-on-surface outline-none transition-colors duration-300 placeholder:text-on-surface-variant/50 focus:border-tertiary focus:ring-2 focus:ring-tertiary/30"
          ></textarea>
        </div>

        <div class="flex flex-col items-start gap-3">
          <button
            type="submit"
            data-form-submit
            class="font-label-caps text-label-caps rounded bg-tertiary px-8 py-4 text-on-tertiary transition-colors duration-300 hover:bg-tertiary-fixed-dim focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tertiary disabled:cursor-not-allowed disabled:opacity-60"
          >
            Enviar mensaje
          </button>
          <p
            data-form-status
            role="status"
            aria-live="polite"
            hidden
            class="font-body-md text-body-md"
          ></p>
        </div>
      </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-form-submit]');
  const statusEl = document.querySelector<HTMLParagraphElement>('[data-form-status]');
  const defaultBtnText = submitBtn?.textContent ?? 'Enviar mensaje';
  const fallbackEmail = form?.dataset.contactEmail ?? '';

  function showStatus(type: 'success' | 'error', message: string) {
    if (!statusEl) return;
    statusEl.hidden = false;
    statusEl.className = `font-body-md text-body-md ${type === 'success' ? 'text-tertiary' : 'text-error'}`;
    statusEl.textContent = message;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (statusEl) statusEl.hidden = true;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando…';
    }
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok !== false) {
        form.reset();
        showStatus('success', 'Mensaje enviado. ¡Gracias por escribirme! Te respondo a la brevedad.');
      } else {
        showStatus(
          'error',
          'No se pudo enviar el mensaje. Intentá de nuevo o escribime directo a ' + fallbackEmail + '.'
        );
      }
    } catch {
      showStatus('error', 'Hubo un problema de red. Escribime directo a ' + fallbackEmail + '.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = defaultBtnText;
      }
    }
  });
</script>