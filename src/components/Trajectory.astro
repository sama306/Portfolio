---
import { experience } from '../data/experience';

const experiencia = experience.filter((item) => item.type === 'experiencia');
const educacion = experience.filter((item) => item.type === 'educacion');
---

<!--
  Trayectoria — sección 2 del Home (ver 03-secciones-home.md §2).
  Fuente de datos: src/data/experience.ts (los items NO se hardcodean acá).
  Col izq: timeline vertical, bullets en tertiary, orden decreciente.
  Col der: educación. [Nombre de la institución] es placeholder visible (confirmar con el usuario).
  Items de experiencia expandibles con <details>/<summary> nativo (sin librerías).
  Entrada por scroll con data-reveal (Fase 5). Hover/focus states: sistema base (02-diseño-visual.md).
-->
<section id="trayectoria" class="mx-auto w-full max-w-[1200px] px-gutter pt-section-gap">
  <h2 class="font-headline-md text-headline-md text-on-surface" data-reveal>Trayectoria</h2>

  <div class="mt-12 grid grid-cols-1 gap-element-gap lg:grid-cols-12 lg:gap-6">
    <!-- ── Columna Experiencia ───────────────────────────── -->
    <div class="flex flex-col lg:col-span-7" data-reveal data-reveal-delay="0.05">
      <p class="font-label-caps text-label-caps text-on-surface-variant">Experiencia</p>

      <ol class="mt-6 flex flex-col">
        {
          experiencia.map((item, index) => (
            <li class="flex gap-5">
              <!-- Timeline: dot con halo + línea conectora -->
              <div class="flex flex-col items-center" aria-hidden="true">
                <span
                  class:list={[
                    'mt-1.5 h-2 w-2 shrink-0 rounded-full ring-4 ring-primary-container',
                    index === 0 ? 'bg-tertiary' : 'bg-surface-variant',
                  ]}
                ></span>
                {index < experiencia.length - 1 && (
                  <span class="mt-1 w-px flex-1 bg-outline-variant"></span>
                )}
              </div>

              <div class={index < experiencia.length - 1 ? 'min-w-0 flex-1 pb-12' : 'min-w-0 flex-1'}>
                <p
                  class:list={[
                    'font-label-caps text-label-caps',
                    index === 0 ? 'text-tertiary' : 'text-on-surface-variant',
                  ]}
                >
                  {item.period}
                </p>
                <h3 class="mt-2 font-body-lg text-body-lg text-on-surface">
                  {item.title}
                  {item.organization && (
                    <span class="text-on-surface-variant"> — {item.organization}</span>
                  )}
                </h3>
                <p class="mt-2 font-body-md text-body-md text-on-surface-variant">
                  {item.description}
                </p>

                {item.linkToVideos && (
                  <a
                    href="/videos"
                    class="hit-area mt-3 inline-block font-body-md text-body-md text-tertiary transition-colors duration-300 hover:text-tertiary-fixed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tertiary rounded-sm"
                  >
                    Ver trabajos audiovisuales <span aria-hidden="true">→</span>
                  </a>
                )}

                {item.details && item.details.length > 0 && (
                  <details class="group mt-4">
                    <summary
                      class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-sm px-1 py-2 font-label-caps text-label-caps text-on-surface-variant transition-colors duration-300 hover:text-tertiary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tertiary"
                    >
                      <span class="trajectory-toggle inline-block" aria-hidden="true">+</span>
                      Responsabilidades
                    </summary>
                    <ul class="mt-3 flex list-disc flex-col gap-2 pl-5 font-body-md text-body-md text-on-surface-variant">
                      {item.details.map((detail) => <li>{detail}</li>)}
                    </ul>
                  </details>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- ── Columna Educación ─────────────────────────────── -->
    <div class="flex flex-col lg:col-span-5" data-reveal data-reveal-delay="0.1">
      <p class="font-label-caps text-label-caps text-on-surface-variant">Educación</p>

      <div class="mt-6 flex flex-col">
        {
          educacion.map((item) => (
            <div>
              <p class="flex items-center gap-2 font-label-caps text-label-caps text-tertiary">
                <span class="h-2 w-2 rounded-full bg-tertiary ring-4 ring-primary-container" aria-hidden="true"></span>
                {item.period}
              </p>
              <h3 class="mt-2 font-body-lg text-body-lg text-on-surface">{item.title}</h3>
              {item.organization && (
                <p class="mt-1 font-body-md text-body-md text-on-surface-variant">
                  {item.organization}
                </p>
              )}
              <p class="mt-2 font-body-md text-body-md text-on-surface-variant">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Tritura el triángulo nativo del <summary> y rota el "+" a "×" al abrir. */
  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  details[open] .trajectory-toggle {
    transform: rotate(45deg);
  }

  .trajectory-toggle {
    color: var(--color-tertiary);
    transition: transform 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .trajectory-toggle {
      transition: none;
    }
  }
</style>