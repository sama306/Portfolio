---
import { socials, type Social } from '../data/socials';

const brandIcons: Record<Social['name'], string> = {
  LinkedIn:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>',
  Instagram:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>',
  GitHub:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>',
} as const;

// Heatmap decorativo de contribuciones (GitHub box). Generado en build time
// con semilla fija para que el patrón sea estable entre compilaciones.
// No es data real: solo un gráfico decorativo en los tonos del sistema.
function mulberry32(seed: number) {
  let a = seed;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(42);
const COLS = 48;
const ROWS = 7;

const heatmap: number[][] = Array.from({ length: ROWS }, () =>
  Array.from({ length: COLS }, () => {
    const v = rand();
    if (v < 0.55) return 0;
    if (v < 0.82) return 1;
    if (v < 0.94) return 2;
    if (v < 0.99) return 3;
    return 4;
  })
);

const CELL = 8;
const GAP = 2;
const chartW = COLS * (CELL + GAP) - GAP;
const chartH = ROWS * (CELL + GAP) - GAP;
const levelOpacity = [0.35, 0.25, 0.5, 0.75, 1];
---
<!--
  Hero — sección 1 del Home (ver 03-secciones-home.md §1).
  Contenido 100% estático (Fase 2). Sin animaciones de scroll (Fase 5).
  Hover states de botones/links: parte del sistema de diseño base (02-diseño-visual.md).
  Visual lateral: cajas de contacto (LinkedIn/Instagram/GitHub) en lugar de foto o gráfico abstracto.
  El texto decorativo grande de fondo se deja afuera (a evaluar después). Copy del headline provisional.
-->

<section class="relative">
  <div
    class="mx-auto grid w-full max-w-[1200px] grid-cols-1 items-center gap-12 px-gutter pb-16 lg:grid-cols-12 lg:gap-6"
  >
    <!-- Columna de contenido -->
    <div class="flex flex-col lg:col-span-7">
      <!-- Status dot pulsante en tertiary -->
      <div class="flex items-center gap-3">
        <span class="status-dot h-3 w-3 rounded-full bg-tertiary" aria-hidden="true"></span>
        <span class="font-label-caps text-label-caps text-tertiary">
          Disponible para nuevos proyectos
        </span>
      </div>

      <!-- Headline provisional en 2 líneas (copy a definir con el usuario) -->
      <h1
        class="font-display-lg text-display-lg-mobile text-on-surface sm:text-display-lg"
      >
        <span class="block">Precisión técnica.</span>
        <span class="block">Impacto real.</span>
      </h1>

      <!-- Presentación -->
      <p class="mt-8 max-w-xl font-body-lg text-body-lg text-on-surface-variant">
        Soy estudiante de Tecnicatura en Programación Informática y desarrollador enfocado en crear
        soluciones digitales — combinando lógica de software con producción audiovisual.
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href="/projects"
          class="font-label-caps text-label-caps rounded bg-tertiary px-8 py-4 text-on-tertiary transition-colors duration-300 hover:bg-tertiary-fixed-dim"
        >
          Ver proyectos
        </a>
        <a
          href="#"
          class="font-label-caps text-label-caps rounded border border-outline-variant px-8 py-4 text-on-surface transition-colors duration-300 hover:border-tertiary hover:text-tertiary"
        >
          Contactarme
        </a>
      </div>
    </div>

    <!-- Cajas de contacto (reemplazan el gráfico del Hero) -->
    <div class="flex flex-col gap-4 lg:col-span-5">
      {
        socials.map((social) =>
          social.name === 'GitHub' ? (
            <a
              href={social.url}
              target="_blank"
              rel="noreferrer"
              class="group flex flex-col gap-5 rounded-lg border border-outline-variant bg-surface-container px-6 py-5 transition-colors duration-300 hover:border-tertiary"
            >
              <span class="flex items-center gap-4">
                <span
                  class="h-7 w-7 shrink-0 text-on-surface-variant transition-colors duration-300 group-hover:text-tertiary"
                  aria-hidden="true"
                  set:html={brandIcons[social.name]}
                ></span>
                <span
                  class="font-label-caps text-label-caps text-on-surface transition-colors duration-300 group-hover:text-tertiary"
                >
                  {social.name}
                </span>
              </span>
              <svg
                viewBox={`0 0 ${chartW} ${chartH}`}
                class="h-auto w-full"
                role="img"
                aria-label="Heatmap decorativo de contribuciones en GitHub"
              >
                {heatmap.map((row, r) =>
                  row.map((level, c) => (
                    <rect
                      key={`${c}-${r}`}
                      x={c * (CELL + GAP)}
                      y={r * (CELL + GAP)}
                      width={CELL}
                      height={CELL}
                      rx={1.5}
                      fill={level === 0 ? 'var(--color-outline-variant)' : 'var(--color-tertiary)'}
                      opacity={levelOpacity[level]}
                    />
                  ))
                )}
              </svg>
            </a>
          ) : (
            <a
              href={social.url}
              target="_blank"
              rel="noreferrer"
              class="group flex items-center gap-4 rounded-lg border border-outline-variant bg-surface-container px-6 py-5 transition-colors duration-300 hover:border-tertiary"
            >
              <span
                class="h-7 w-7 shrink-0 text-on-surface-variant transition-colors duration-300 group-hover:text-tertiary"
                aria-hidden="true"
                set:html={brandIcons[social.name]}
              ></span>
              <span
                class="font-label-caps text-label-caps text-on-surface transition-colors duration-300 group-hover:text-tertiary"
              >
                {social.name}
              </span>
            </a>
          )
        )
      }
    </div>
  </div>
</section>

<style>
  /* Status dot pulsante (componente base, no una animación de scroll — Fase 2). */
  .status-dot {
    animation: hero-status-pulse 2.4s ease-in-out infinite;
  }

  @keyframes hero-status-pulse {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 0 0 rgba(0, 220, 229, 0.35);
    }
    50% {
      opacity: 0.9;
      box-shadow: 0 0 0 5px rgba(0, 220, 229, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }
</style>