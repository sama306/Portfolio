---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProjectGrid from '../../components/ProjectGrid';
import TechnicalExplorations from '../../components/TechnicalExplorations.astro';
import { projects } from '../../data/projects';
---

<Layout title="Proyectos — Dante Samacoits">
  <Navbar />

  <main class="flex-1 pt-32 pb-section-gap">
    <!-- Header de la página (ver 04-proyectos.md): título en 2 líneas, segunda en cyan -->
    <header class="mx-auto w-full max-w-[1200px] px-gutter text-center md:text-left">
      <h1 class="font-display-lg text-display-lg-mobile text-on-surface md:text-display-lg">
        <span class="block">Proyectos</span>
        <span class="block text-tertiary">Seleccionados.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl font-body-lg text-body-lg text-on-surface-variant md:mx-0">
        Una colección de soluciones desarrolladas experimentando con distintas tecnologías,
        arquitecturas y conceptos.
      </p>
    </header>

    <ProjectGrid client:load projects={projects} />

    <TechnicalExplorations />
  </main>

  <Footer />
</Layout>