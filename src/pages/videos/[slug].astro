---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import VideoLayout from '../../layouts/VideoLayout.astro';
import { videos } from '../../data/videos';
import type { VideoWork } from '../../data/videos';

/*
  Página individual de video (ver 05-audiovisual.md §"Página individual de video").
  Ruta dinámica: genera una página estática por cada slug de videos.ts.
  Navegación prev/next por orden del array, con wraparound. Video nuevo =
  agregarlo a videos.ts, sin tocar esto.
*/

export function getStaticPaths() {
  return videos.map((video) => ({
    params: { slug: video.slug },
    props: { video },
  }));
}

const { video } = Astro.props as { video: VideoWork };

const index = videos.findIndex((item) => item.slug === video.slug);
const prev = videos[(index - 1 + videos.length) % videos.length];
const next = videos[(index + 1) % videos.length];
---

<Layout title={`${video.title} — Dante Samacoits`}>
  <Navbar />
  <VideoLayout video={video} prev={prev} next={next} />
  <Footer />
</Layout>