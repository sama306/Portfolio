---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import VideoGrid from '../../components/VideoGrid';
import { videos } from '../../data/videos';
---

<Layout
  title="Audiovisual — Dante Samacoits"
  description="Producción audiovisual de Dante Samacoits: edición cinematográfica, corrección de color y ritmo narrativo aplicados a recorridos inmobiliarios y contenido para redes.">
  <Navbar />

  <main class="flex-1 pt-32 pb-section-gap">
    <!-- Header de la página (ver 05-audiovisual.md): título display-lg + subtítulo body-lg -->
    <header class="mx-auto w-full max-w-[1200px] px-gutter text-center md:text-left" data-reveal>
      <h1 class="font-display-lg text-display-lg-mobile text-on-surface md:text-display-lg">
        Producción Audiovisual.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl font-body-lg text-body-lg text-on-surface-variant md:mx-0">
        Edición cinematográfica, corrección de color y ritmo narrativo aplicados a contenido
        inmobiliario. Videos pensados para captar la atención y transmitir calidad desde el
        primer segundo.
      </p>
    </header>

    <div data-reveal>
      <VideoGrid client:visible videos={videos} />
    </div>
  </main>

  <Footer />
</Layout>